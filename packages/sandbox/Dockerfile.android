# syntax=docker/dockerfile:1.7-labs
#
# cmux-sandbox-android — Android emulator resource provider image.
#
# Built FROM the base cmux-sandbox image. Adds:
#   - OpenJDK 17
#   - Android cmdline-tools, platform-tools, emulator
#   - system-images;android-35;google_apis;x86_64
#   - An AVD named "cmux-android"
#   - Xvfb / TigerVNC / websockify for VNC streaming of the emulator display
#   - The in-container vm-android-mcp-server (HTTP + bearer MCP)
#
# The emulator requires /dev/kvm passed through to the container at launch.
#
# Build:
#   docker build -t cmux-sandbox-android -f packages/sandbox/Dockerfile.android .
# Then import into Incus as alias `cmux-sandbox-android`:
#   bash scripts/setup-incus-android.sh

ARG BASE_IMAGE=cmux-sandbox:latest
FROM ${BASE_IMAGE}

ENV ANDROID_SDK_ROOT=/opt/android-sdk \
    ANDROID_HOME=/opt/android-sdk \
    ANDROID_AVD_HOME=/root/.android/avd \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    DEBIAN_FRONTEND=noninteractive

# Versions are pinned so rebuilds are reproducible.
ARG ANDROID_CMDLINE_TOOLS_VERSION=11076708
ARG ANDROID_PLATFORM=android-35
ARG ANDROID_SYSTEM_IMAGE="system-images;android-35;google_apis;x86_64"
ARG ANDROID_AVD_NAME=cmux-android

# --- System packages: JDK + display stack ---------------------------------
# socat is used by the android_proxy_workspace_port MCP tool to forward
# 127.0.0.1:<port> in the container to the workspace's tailscale hostname,
# so apps running on the emulator can reach a dev server in the workspace
# via 10.0.2.2:<port>. rsync is used by android_sync_code to pull workspace
# source for `flutter build apk`. xz-utils is needed to extract the flutter
# SDK tarball below.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      openjdk-17-jdk-headless \
      xvfb \
      websockify \
      libpulse0 \
      libgl1 \
      libnss3 \
      libxcursor1 \
      libxi6 \
      libxtst6 \
      qemu-utils \
      socat \
      rsync \
      xz-utils \
      git \
    && rm -rf /var/lib/apt/lists/*

# --- Android SDK: cmdline-tools, platform-tools, emulator, system image ----
RUN set -eux; \
    mkdir -p "${ANDROID_SDK_ROOT}/cmdline-tools"; \
    cd /tmp; \
    wget -q "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip" -O cmdline-tools.zip; \
    unzip -q cmdline-tools.zip -d "${ANDROID_SDK_ROOT}/cmdline-tools"; \
    mv "${ANDROID_SDK_ROOT}/cmdline-tools/cmdline-tools" "${ANDROID_SDK_ROOT}/cmdline-tools/latest"; \
    rm cmdline-tools.zip

ENV PATH="${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin:${ANDROID_SDK_ROOT}/platform-tools:${ANDROID_SDK_ROOT}/emulator:${PATH}"

RUN set -eu; \
    (yes 2>/dev/null | sdkmanager --licenses >/dev/null) || true; \
    sdkmanager --install \
      "platform-tools" \
      "emulator" \
      "platforms;${ANDROID_PLATFORM}" \
      "build-tools;35.0.0" \
      "${ANDROID_SYSTEM_IMAGE}"

# --- Flutter SDK ----------------------------------------------------------
# Pinned to a recent stable so `flutter build apk` works out of the box for
# Dart 3 / AndroidX projects. Installed at /opt/flutter and added to PATH.
# We also pre-accept Android SDK licenses via flutter, otherwise the first
# `flutter build apk` errors out.
ARG FLUTTER_VERSION=3.44.0
ENV FLUTTER_HOME=/opt/flutter \
    PUB_CACHE=/opt/flutter/.pub-cache
RUN set -eux; \
    cd /opt; \
    wget -q "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" -O flutter.tar.xz; \
    tar -xJf flutter.tar.xz; \
    rm flutter.tar.xz; \
    chown -R root:root /opt/flutter; \
    git config --global --add safe.directory /opt/flutter

ENV PATH="${FLUTTER_HOME}/bin:/root/.pub-cache/bin:${PATH}"

# Pre-accept Android licenses for flutter, run `flutter --version` to
# initialize, and pre-cache android artifacts so the first build is fast.
RUN set -eu; \
    yes | flutter doctor --android-licenses >/dev/null 2>&1 || true; \
    flutter config --no-analytics >/dev/null 2>&1 || true; \
    flutter --version || true; \
    flutter precache --android --no-ios --no-linux --no-windows --no-macos --no-web --no-fuchsia || true

# --- FVM (Flutter Version Manager) ----------------------------------------
# Real-world flutter apps pin to specific SDK versions because changes like
# `IconData` becoming `final` in 3.40+ break older packages (e.g.
# font_awesome_flutter 10.7.0). fvm lets each project use its own pinned
# Flutter version. android_build_flutter auto-detects .fvmrc /
# .fvm/fvm_config.json / android/local.properties references and runs
# `fvm flutter` / `fvm dart` instead of the system /opt/flutter.
#
# Pre-cache Flutter 3.38.4 (the version moneydolly-app pins) so the
# first build doesn't spend ~5 minutes downloading. Other versions
# download on demand at allocation time.
ARG FVM_PRECACHE_VERSIONS=3.38.4
RUN set -eux; \
    dart pub global activate fvm 2>&1 | tail -5; \
    fvm config --cache-path /root/fvm >/dev/null 2>&1 || true; \
    for v in ${FVM_PRECACHE_VERSIONS}; do \
      fvm install "${v}" --no-setup 2>&1 | tail -3 || true; \
    done; \
    fvm list 2>&1 | tail -5 || true

# --- Create the AVD --------------------------------------------------------
RUN set -eux; \
    mkdir -p "${ANDROID_AVD_HOME}"; \
    echo "no" | avdmanager create avd \
      --name "${ANDROID_AVD_NAME}" \
      --package "${ANDROID_SYSTEM_IMAGE}" \
      --device "pixel_6" \
      --force; \
    printf 'hw.lcd.density=420\nhw.keyboard=yes\nhw.gpu.enabled=yes\nhw.gpu.mode=swiftshader_indirect\ndisk.dataPartition.size=6G\n' \
      >> "${ANDROID_AVD_HOME}/${ANDROID_AVD_NAME}.avd/config.ini"

# --- VNC display stack for the emulator ------------------------------------
# Xtigervnc IS the X server (no separate Xvfb): it provides display :2 AND
# serves it over VNC on port 5902. websockify then bridges 5902 → 39384 for
# the in-browser noVNC client. The emulator is launched with DISPLAY=:2 so
# it renders directly into Xtigervnc's framebuffer.
COPY --link configs/systemd/cmux-android-tigervnc.service /etc/systemd/system/cmux-android-tigervnc.service
COPY --link configs/systemd/cmux-android-vnc-proxy.service /etc/systemd/system/cmux-android-vnc-proxy.service

# Tailscale is enabled by default so the host backend and the workspace
# container can reach the Android container's MCP server + VNC stream via
# MagicDNS. The actual `tailscale up --authkey=...` runs at launch time
# via the incus-resource-provider; we just need tailscaled itself running.
RUN systemctl enable tailscaled.service

RUN printf '#!/bin/sh\nexec /usr/bin/websockify --web=/usr/share/novnc "${CMUX_VNC_PROXY_PORT:-39384}" "127.0.0.1:${CMUX_VNC_TARGET_PORT:-5902}"\n' \
      > /usr/local/lib/cmux/cmux-vnc-proxy && \
    chmod +x /usr/local/lib/cmux/cmux-vnc-proxy

# --- vm-android-mcp-server -------------------------------------------------
# Bundle the in-container MCP server source. It is started per-allocation by
# the host-side incus-resource-provider.
COPY --link packages/vm-android-mcp-server /opt/cmux/vm-android-mcp-server

RUN printf '[Unit]\n\
Description=Cmux Android in-VM MCP server\n\
After=network.target\n\
\n\
[Service]\n\
Type=simple\n\
Environment=CMUX_VM_MCP_PORT=4860\n\
Environment=ANDROID_SDK_ROOT=%s\n\
Environment=ANDROID_HOME=%s\n\
Environment=ANDROID_AVD_HOME=%s\n\
Environment=PATH=%s/cmdline-tools/latest/bin:%s/platform-tools:%s/emulator:/opt/flutter/bin:/root/.pub-cache/bin:/usr/local/bin:/usr/bin:/bin\n\
ExecStart=/usr/local/bin/bun run /opt/cmux/vm-android-mcp-server/src/server.ts\n\
Restart=always\n\
RestartSec=3\n\
StandardOutput=append:/var/log/cmux/android-mcp.log\n\
StandardError=append:/var/log/cmux/android-mcp.log\n\
\n\
[Install]\n\
WantedBy=multi-user.target\n' \
      "${ANDROID_SDK_ROOT}" "${ANDROID_HOME}" "${ANDROID_AVD_HOME}" \
      "${ANDROID_SDK_ROOT}" "${ANDROID_SDK_ROOT}" "${ANDROID_SDK_ROOT}" \
      > /etc/systemd/system/cmux-android-mcp.service && \
    mkdir -p /etc/systemd/system/multi-user.target.wants /var/log/cmux && \
    ln -sf /etc/systemd/system/cmux-android-mcp.service \
      /etc/systemd/system/multi-user.target.wants/cmux-android-mcp.service

EXPOSE 4860 39384

LABEL org.cmux.image="cmux-sandbox-android"
